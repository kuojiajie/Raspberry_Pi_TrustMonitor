# ==============================================================================
# TrustMonitor Health Monitor Configuration
# ==============================================================================
# This file contains configuration variables for TrustMonitor health monitoring system
# Copy this file to health-monitor.env and modify as needed
#
# 🔧 Configuration Validation (v3.1.5+):
# Use tools/config/validate_config.sh to validate this configuration file
# Supports: --system-only, --paths-only, --logging-only, --watchdog-only, --sel-only
# Example: bash tools/config/validate_config.sh --system-only

# ==============================================================================
# 🌐 NETWORK MONITORING
# ==============================================================================
PING_TARGET=8.8.8.8
NETWORK_TIMEOUT=5

# ==============================================================================
# ⏱️ MONITORING INTERVALS
# ==============================================================================
CHECK_INTERVAL=30                    # Health check frequency (seconds)
INTEGRITY_CHECK_INTERVAL=3600       # Integrity check frequency (1 hour)

# ==============================================================================
# 💻 SYSTEM THRESHOLDS
# ==============================================================================
# CPU Load Thresholds (1-minute average)
# Note: Validated by validate_system_thresholds() - supports floating point values
CPU_LOAD_WARN=1.50
CPU_LOAD_ERROR=3.00

# Memory Availability Thresholds (percentage)
# Note: Validated by validate_system_thresholds() - warning > error for availability
MEM_AVAIL_WARN_PCT=15
MEM_AVAIL_ERROR_PCT=5

# Disk Usage Thresholds (percentage)
# Note: Validated by validate_system_thresholds() - warning < error for usage
DISK_USED_WARN_PCT=80
DISK_USED_ERROR_PCT=90

# CPU Temperature Thresholds (Pi 4 safe range: 0-85°C, throttling at 60-70°C)
# Note: Validated by validate_temperature_thresholds() - supports floating point values
CPU_TEMP_WARN=65.0
CPU_TEMP_ERROR=75.0

# ==============================================================================
# 🌐 NETWORK QUALITY THRESHOLDS
# ==============================================================================
NETWORK_LATENCY_WARN_MS=200
NETWORK_LATENCY_ERROR_MS=500
NETWORK_PACKET_LOSS_WARN_PCT=10
NETWORK_PACKET_LOSS_ERROR_PCT=30

# ==============================================================================
# 🌡️ SENSOR MONITORING (DHT11)
# ==============================================================================
# Temperature Thresholds (Celsius)
TEMP_WARNING=40.0
TEMP_ERROR=45.0

# Humidity Thresholds (percentage)
HUMIDITY_WARNING=70.0
HUMIDITY_ERROR=80.0

# Sensor Retry Configuration
SENSOR_MAX_RETRIES=3
SENSOR_RETRY_DELAY=1.0
SENSOR_MONITOR_INTERVAL=60

# ==============================================================================
# 🔧 HARDWARE CONFIGURATION
# ==============================================================================
# GPIO Pin Configuration
DHT11_PIN=17                        # DHT11 sensor GPIO pin (corrected to GPIO 17)
DHT_PIN=D17                         # DHT sensor pin for HAL system (GPIO 17)
USE_HAL=true                         # Use Hardware Abstraction Layer

# LED Pin Configuration (RGB LED - Common Anode)
# Note: HAL LED controller supports --daemon mode for non-interactive operation
LED_RED_PIN=27
LED_GREEN_PIN=22
LED_BLUE_PIN=5

# ==============================================================================
# 📁 PATH CONFIGURATION (Optional - Override defaults)
# ==============================================================================
# Note: Validated by validate_paths() - checks existence, permissions, and security
# These paths are automatically managed by unified path system
# Override only if you have custom requirements
PROJECT_ROOT=/home/kuojiajie9999/Raspberry_Pi_TrustMonitor
DATA_DIR=/home/kuojiajie9999/Raspberry_Pi_TrustMonitor/data
KEYS_DIR=/home/kuojiajie9999/Raspberry_Pi_TrustMonitor/data/keys

# ==============================================================================
# 🔒 SECURITY CONFIGURATION
# ==============================================================================
# RSA Key Configuration
RSA_KEY_SIZE=2048                    # RSA key size in bits

# Hash Algorithm
HASH_ALGORITHM=sha256                # Hash algorithm for integrity checks

# ==============================================================================
# 📝 LOGGING CONFIGURATION
# ==============================================================================
# Note: Validated by validate_logging_config() - checks level validity and format placeholders
# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Log Format
# Note: Must contain %LEVEL% and %MESSAGE%, optionally %COMPONENT% and %TIMESTAMP%
LOG_FORMAT="[%Y-%m-%d %H:%M:%S] [%LEVEL%] [%COMPONENT%] %MESSAGE%"

# ==============================================================================
# 🐕 PHASE 3: WATCHDOG CONFIGURATION
# ==============================================================================
# Note: Validated by validate_watchdog_config() - checks intervals, retries, and service names
# Watchdog monitoring intervals
WATCHDOG_INTERVAL=300                    # Watchdog check frequency (seconds, 5 minutes)
WATCHDOG_TIMEOUT=600                     # Service timeout threshold (seconds, 10 minutes)
WATCHDOG_MAX_RETRIES=3                   # Maximum retry attempts for service recovery
WATCHDOG_RECOVERY_DELAY=10               # Delay between recovery attempts (seconds)

# Critical services to monitor
# Note: Service names should end with .suffix (e.g., .service)
WATCHDOG_SERVICES=health-monitor.service  # Services monitored by watchdog

# Watchdog system thresholds
WATCHDOG_CPU_THRESHOLD=5.0               # CPU load threshold for watchdog
WATCHDOG_MEM_THRESHOLD=1.0               # Memory availability threshold (GB) - corrected for Pi
WATCHDOG_DISK_THRESHOLD=95               # Disk usage threshold for watchdog (%)
WATCHDOG_CPU_TEMP_WARN=65.0              # CPU temperature warning threshold for watchdog (°C)
WATCHDOG_CPU_TEMP_ERROR=75.0             # CPU temperature error threshold for watchdog (°C)

# ==============================================================================
# 📋 PHASE 3: SYSTEM EVENT LOG (SEL) CONFIGURATION
# ==============================================================================
# Note: Validated by validate_sel_config() - checks entries, retention, and boolean values
# SEL log management
SEL_MAX_ENTRIES=1000                     # Maximum SEL entries before rotation
SEL_RETENTION_DAYS=30                    # SEL backup retention period (days)

# SEL event filtering
# Note: Boolean values must be 'true' or 'false'
SEL_LOG_CRITICAL_EVENTS=true              # Auto-log critical events to SEL
SEL_LOG_SECURITY_EVENTS=true             # Auto-log security events to SEL
SEL_LOG_WATCHDOG_EVENTS=true             # Auto-log watchdog events to SEL