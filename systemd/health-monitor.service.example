# systemd/health-monitor.service
# Copy to: /etc/systemd/system/health-monitor.service
# Update paths according to your installation

[Unit]
Description=TrustMonitor BMC/ROT POC (network/cpu/memory/disk/sensor/led)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as a non-root user (update to your actual user)
User=your_user
Group=your_user

# Project working directory (update path)
WorkingDirectory=/path/to/your/trustmonitor

# Load environment variables (update path)
EnvironmentFile=/path/to/your/trustmonitor/config/health-monitor.env

# Security hardening for v3.1.1 (balanced approach)
NoNewPrivileges=true
ProtectSystem=true
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/path/to/your/trustmonitor/logs /path/to/your/trustmonitor/data/runtime
MemoryMax=512M
CPUQuota=50%

# Process restrictions
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging -> journald with improved identification
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trustmonitor

# Start script (update path)
ExecStart=/bin/bash /path/to/your/trustmonitor/daemon/health_monitor.sh

# Restart policy
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
