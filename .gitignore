# ==============================================================================
# TrustMonitor .gitignore
# ==============================================================================
# Clean, organized ignore patterns for TrustMonitor project
# Updated for v3.1.8 Production Security Architecture

# Configuration files (user-specific)
config/health-monitor.env
.env
.env.*

# Runtime files (generated during operation)
data/runtime/
logs/
*.pid
*.log
*.json

# Runtime data should not be in repo
data/manifest.sha256
data/manifest.sha256.sig
data/runtime/
data/*.log
data/*.json

# NEW: Integrity directory (production structure)
data/integrity/manifest.sha256
data/integrity/manifest.sha256.sig
!data/integrity/public_key.pem

# Configuration validation reports (v3.1.5+)
config/validation_report_*.txt
config/validation_report_*.json
config/validation_report_*.html

# Test framework results and logs (v3.1.7+)
tests/results/
tests/logs/
tests/tmp/
test_logs/
test_results/
tests/test_results_*.json
tests/test_report_*.txt

# Test runner scripts (temporary files)
test_runner_stable*.sh
test_runner_auto*.sh
test_runner_manual*.sh

# Error handling logs (generated during testing)
*error.log
*error_*.log
*debug.log
*debug_*.log

# Security files (generated, should not be committed)
manifest.sha256
manifest.sha256.sig
keys/
data/keys/
data/keys/backup_*/

# NEVER commit private keys - CRITICAL SECURITY
**/private_key.pem
data/keys/private_key.pem
backup/**/private_key.pem
keys/private_key.pem
data/keys/
backup/security/keys/
keys/

# Public keys are OK for verification only in integrity directory
!data/integrity/public_key.pem

# Backup directories (generated)
backup/
!backup/.gitkeep

# Python cache
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Development files
*.tmp
*.bak
*.swp
*.swo
*~
.last_*
.DS_Store
.vscode/
.idea/

# System service (user-specific paths)
systemd/health-monitor.service
systemd/health-monitor.service.*

# Legacy directories (v3.1.8 migration)
data/keys/backup_*/
